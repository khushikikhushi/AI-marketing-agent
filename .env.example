# ============ AI (text, strategy, copy, review) ============
# openai (default) or claude (the original version, kept as a fallback)
TEXT_PROVIDER=openai

# Optional: you can paste the key in the app instead (Settings -> Connections).
# From platform.openai.com -> API keys. Billed separately from ChatGPT Plus/Free.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6
# How hard the model thinks: low, medium, high
OPENAI_REASONING_EFFORT=high

# ============ Images ============
# GPT Image may need Organization Verification: platform.openai.com -> Settings -> Organization -> General
IMAGE_GENERATION=on
OPENAI_IMAGE_MODEL=gpt-image-2
# low, medium or high (high looks best and costs most)
OPENAI_IMAGE_QUALITY=high

# ============ Claude (only used if TEXT_PROVIDER=claude) ============
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ============ Quality control ============
# Creative reviews per design (review -> refine -> review ...). 1 = fastest/cheapest.
REVIEW_ROUNDS=3

# ============ Instagram ============
# Starting value only; admins switch it in Settings. While true, NOTHING is ever posted.
IG_TEST_MODE=true
# Long-lived token from your Meta app (README -> Instagram). Never share it.
IG_ACCESS_TOKEN=
# Optional — filled in automatically from the token
IG_USER_ID=
# Optional — only if you host this app at a public https address yourself
PUBLIC_BASE_URL=

# ============ Cost tracking (optional) ============
# Copy current prices from openai.com/api/pricing to see estimated costs on the Usage page.
PRICE_TEXT_INPUT_PER_1M=
PRICE_TEXT_OUTPUT_PER_1M=
PRICE_PER_IMAGE=
